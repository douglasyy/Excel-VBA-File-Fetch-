def groupby_relationship(file_path):
    history = dd.read_parquet(file_path, columns=['Relationship Number', 'Deposit Account Number', 'Date', 'Deposit Ledger Balance'])
    history['Daily Change'] = 0.0
    history = history.compute()
    history.reset_index(inplace=True)
    print('Data read into memory')

    # Prepare aggregation variables for indexing and calculating balance
    latest_accounts = np.array(history[history['Date'] == max(np.array(history['Date']))]['Deposit Account Number'])
    account_num = np.unique(history['Deposit Account Number'])
    closed_accts = [a for a in account_num if a not in latest_accounts]
    account_list = np.array(history['Deposit Account Number'])
    balance_list = np.array(history['Deposit Ledger Balance'])
    total_accts = len(account_num)

    index_list = []
    for n in account_list:
        index_list.append([])

    # Create dictionary of empty lists
    account_ranges_dict = dict(zip(account_list, index_list))

    # Populate empty lists with index locations for each distinct account number
    for ind, ele in enumerate(account_list):
        account_ranges_dict.get(ele).append(ind)
    print('Variables, dictionaries and lists prepared')

    # Loop through each unique account and calculate daily change amount by product using precise account level index locations
    for ind, account in enumerate(account_num):
        # print(f'processing account {ind + 1} of {total_accts}')
        index_range = account_ranges_dict[account]
        if account in closed_accts:
            try:
                change = np.diff(balance_list[index_range], 1)
                change[-1] = -balance_list[index_range][-1]
                change = np.insert(change, 0, 0)
            except IndexError:
                change = np.array(0, 'float64')
        else:
            change = np.diff(balance_list[index_range], 1)
            change = np.insert(change, 0, 0)
        history.loc[index_range, 'Daily Change'] = change
    print("Change amounts calculated")

    print('Grouping by relationship')
    aggregate = {**{col: 'first' for col in history.select_dtypes(include=object).columns},
                 **{col: 'first' for col in history.select_dtypes(include=[np.datetime64]).columns},
                 **{col: 'sum' for col in history.select_dtypes(include=float).columns}}

    grouped = history.groupby(['Relationship Number', 'Deposit Account Number', 'Date']).agg(aggregate)
    print('Deposit data grouped')

    grouped.to_parquet(path='H:/FR 2052a/Automation/Databases/Deposit Schema Tables/Calculated Tables/Deposit Relationship Totals.parquet', engine='pyarrow', compression='brotli')
    print('Relationship totals exported')
    return


def groupby_relationship_daily(dask_df, date_string):
    current = dask_df[['Relationship Number', 'Deposit Account Number', 'Date', 'Deposit Ledger Balance']]
    current['Daily Change'] = 0.0
    current = current.compute()

    # Formatted current date and current date datetime object
    todays_date = datetime.datetime(year=int(date_string[0:4]), month=int(date_string[4:6]), day=int(date_string[6:8]), tzinfo=pytz.utc)

    # Manual prior day time series if CIBC does not observe a Federal Holiday (floating holiday)
    prior_bd = pd.Timestamp(todays_date) + pd.tseries.offsets.CustomBusinessDay(n=-1, calendar=USFederalHolidayCalendar())
    prior_bd2 = pd.Timestamp(todays_date) + pd.tseries.offsets.CustomBusinessDay(n=-2, calendar=USFederalHolidayCalendar())
    # prior_bd = pd.Timestamp(todays_date) + pd.tseries.offsets.CustomBusinessDay(n=-1)
    prior_bd_str = datetime.datetime.strftime(prior_bd, "%Y%m%d")
    prior_bd_str2 = datetime.datetime.strftime(prior_bd2, "%Y%m%d")

    # Create list of files in deposit archival folder
    deposit_files = []
    for dir_path, dir_names, file_names in os.walk('H:/FR 2052a/Automation/Databases/Deposits/'):
        deposit_files.extend(file_names)

    # Get the name of the latest deposit archive file
    prior_day_file = [x for x in deposit_files if prior_bd_str in x or prior_bd_str2 in x]
    prior = pd.read_parquet(f'H:/FR 2052a/Automation/Databases/Deposits/{prior_day_file[0]}',
                            columns=['Relationship Number', 'Deposit Account Number', 'Deposit Type Code', 'Date', 'Deposit Ledger Balance'])

    # Combine current and previous files
    history = pd.concat([prior, current])
    history.reset_index(inplace=True)
    print('Data read into memory')

    print('Preparing variables...')
    # Compare current and prior day accounts to determine which are closed and which are new
    prior_day_accounts = np.unique(prior['Deposit Account Number'])
    current_day_accounts = np.unique(current['Deposit Account Number'])
    closed_accts = [a for a in prior_day_accounts if a not in current_day_accounts]
    new_accts = [a for a in current_day_accounts if a not in prior_day_accounts]

    # Prepare aggregation variables for indexing and calculating balance
    account_num = np.unique(history['Deposit Account Number'])
    account_list = np.array(history['Deposit Account Number'])
    balance_list = np.array(history['Deposit Ledger Balance'])
    total_accts = len(account_num)

    index_list = []
    for n in account_list:
        index_list.append([])

    # Create dictionary of empty lists
    account_ranges_dict = dict(zip(account_list, index_list))

    # Populate empty lists with index locations for each distinct account number
    for ind, ele in enumerate(account_list):
        account_ranges_dict.get(ele).append(ind)
    print('Variables, dictionaries and lists prepared')

    # Loop through each unique account and calculate daily change amount by product using precise account level index locations
    for ind, account in enumerate(account_num):
        index_range = account_ranges_dict[account]
        # print(f'processing account {ind + 1} of {total_accts}')
        if account in closed_accts:
            change = -np.array(balance_list[index_range])
        elif account in new_accts:
            change = np.array(balance_list[index_range])
        else:
            change = np.diff(balance_list[index_range], 1)
            change = np.insert(change, 0, 0)
        history.loc[index_range, 'Daily Change'] = change
    print("Change amounts calculated")

    print('Grouping by relationship')
    aggregate = {**{col: 'first' for col in history.select_dtypes(include=object).columns},
                 **{col: 'first' for col in history.select_dtypes(include=[np.datetime64]).columns},
                 **{col: 'sum' for col in history.select_dtypes(include=float).columns}}

    grouped = history.groupby(['Relationship Number', 'Deposit Account Number', 'Date']).agg(aggregate)
    print('Deposit data grouped')

    current_change = grouped[grouped['Date'] == pd.Timestamp(todays_date).strftime('%Y-%m-%d')]

    current_change.to_parquet(path=f'H:/FR 2052a/Automation/Databases/Deposit Schema Tables/Calculated Tables/Deposit Relationship Totals {date_string}.parquet', engine='pyarrow', compression='brotli')
    print('Relationship totals exported')
    return


def fix_account_number(df):

    accounts = df['Deposit Account Number'].tolist()

    # Loop through accounts and convert to simple whole number format, stripping leading zeros and trailing values
    for n, acc in enumerate(accounts):
        if "-" in acc and 'ICS' not in acc:
            accounts[n] = int(acc[:11].lstrip("0"))
        elif 'ICS' in accounts[n]:
            accounts[n] = int(acc.replace("-ICS", "99").lstrip("0"))
        else:
            accounts[n] = int(acc)

    # Replace original values in the dataframe and change the column types to integer
    df['Deposit Account Number'] = accounts

    cdw_report_cols = np.array(['Relationship Number', 'Deposit Account Number', 'Account NAICS', 'Dep Profit Center No.'])
    if np.isin(cdw_report_cols, df.columns.values).all():
        df = df.astype({'Relationship Number': 'int64', 'Deposit Account Number': 'int64', 'Account NAICS': 'int64', 'Dep Profit Center No.': 'int64'})
    else:
        df = df.astype({'Deposit Account Number': 'int64'})

    return df


