def extract_deposit_email(parquet_path):
    # Open outlook and locate folder containing reports
    current_day_dash = '01-02-2024'
    outlook = win32.Dispatch("Outlook.Application").GetNamespace("MAPI")
    inbox = outlook.GetDefaultFolder(6)
    reports = inbox.Folders.item("Daily Reporting")
    messages = reports.Items
    # messages = messages.Restrict("[ReceivedTime] >= '" + current_day_dash + "'")
    messages = messages.Restrict("[ReceivedTime] >= '" + current_day_dash + "' AND [Subject] = 'Report: Treasury Deposit Model Data'")

    for message in messages:
        received = str(message.ReceivedTime.month) + '-' + str(message.ReceivedTime.day) + '-' + str(message.ReceivedTime.year)
        if message.Subject == 'Report: Treasury Deposit Model Data':
            for attachment in message.Attachments:
                attachment.SaveAsFile(os.path.join(parquet_path + 'Deposit Files/', f'Treasury Deposit Model Data {received}.xlsx'))
    return

